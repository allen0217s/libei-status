{
  "name": "libei-status",
  "version": "3.0.0-preview.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build && node scripts/sync-dist.cjs",
    "test": "node tests/run-universal.mjs",
    "test:browser": "node tests/universal.browser.cjs",
    "test:rules": "node tests/rules-page.browser.cjs",
    "test:fields": "node tests/field-schema.browser.cjs",
    "test:references": "node tests/rules-references.browser.cjs",
    "test:presets": "node tests/presets.browser.cjs",
    "test:story": "node tests/story-output.browser.cjs",
    "test:context": "node tests/context-page.browser.cjs",
    "test:updates": "node tests/update-experience.browser.cjs",
    "test:legacy": "node tests/field-schema.test.mjs && node tests/rule-sections.test.mjs && node tests/field-engine.test.mjs && node tests/story-output.test.mjs && node tests/clothing-presets.test.mjs && node tests/initial-selection.test.mjs && node tests/worldbook-references.test.mjs && node tests/run-api-unit.mjs",
